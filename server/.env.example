# Server Port
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# Firebase Project ID
FIREBASE_PROJECT_ID=anizai-ai

# Firebase Admin SDK authentication (choose ONE):
#
# Option A — gcloud ADC (recommended, no file needed):
#   Run once per machine: gcloud auth application-default login
#
# Option B — Service account key file (for teammates without gcloud):
#   1. Download a key from Firebase Console → Project Settings → Service Accounts
#   2. Save it somewhere on your machine (do NOT commit it)
#   3. Set this variable to its absolute path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Emulators (Local Development Only)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
