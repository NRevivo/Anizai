{
    "name": "anizai-server",
    "version": "1.0.0",
    "description": "Anizai Backend API Server",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev:emu": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 FIRESTORE_EMULATOR_HOST=localhost:8080 npm run dev",
        "emu:token": "tsx scripts/emulator-get-id-token.ts",
        "emu:test:me": "TOKEN=$(npm run --silent emu:token) && curl -v http://localhost:3000/me -H \"Authorization: Bearer $TOKEN\"",
        "test:session-result": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 FIRESTORE_EMULATOR_HOST=localhost:8080 tsx scripts/test-session-result.ts",
        "migrate:demo-data": "tsx scripts/migrate-demo-data.ts",
        "probe:all-sessions": "tsx scripts/probe-all-sessions.ts"
    },
    "keywords": [
        "anizai",
        "forecasting",
        "api"
    ],
    "author": "Anizai Team",
    "license": "MIT",
    "dependencies": {
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "firebase-admin": "^13.6.0",
        "pino": "^9.6.0",
        "pino-http": "^10.4.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.7",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.4.2",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.21.0",
        "vitest": "^3.0.4"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}