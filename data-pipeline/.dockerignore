# ==========================================================
# Anizai Data Pipeline — Docker Build Context Exclusions
# ==========================================================
# Build context root: data-pipeline/
# This file keeps the build context lean and prevents credentials
# or large irrelevant directories from entering any Docker image.
# ==========================================================

# Virtual environment — large, OS-specific, not needed in containers
venv/

# Python bytecode — container regenerates for its own Python version
__pycache__/
*.pyc
*.pyo

# Credentials — secrets are injected at runtime via env_file, never baked in
.env
.env.example

# Telegram session files — sensitive auth state
*.session
*.session-journal

# Tests run against the container from the host, not inside the image
tests/
.pytest_cache/

# Infrastructure config lives here but is not needed inside the Flink image
# (Dockerfile.flink itself is referenced by path, not COPY'd into the image)
infrastructure/

# ingestion/ and orchestration/ are intentionally NOT excluded here.
# Dockerfile.flink uses explicit per-directory COPY instructions so these
# directories are safely ignored by the Flink build regardless.
# Dockerfile.airflow uses COPY . /opt/airflow/data-pipeline/ and requires
# both directories to be in the build context (production mode, C4).
# Dockerfile.polymarket, Dockerfile.telegram, Dockerfile.trigger_consumer
# likewise need ingestion/ or orchestration/ in the build context (C4).

# Local data and log files
data/
logs/
firestore-debug.log

# Documentation
*.md

# IDE metadata
.idea/
.vscode/


# Git history — not needed in runtime image
.git/
.gitignore
