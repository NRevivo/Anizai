# ==========================================================
# Anizai Data Pipeline — Environment Variables Template
# ==========================================================
# Copy this file to .env and fill in all values before starting
# the Docker stack.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your actual credentials
#
# IMPORTANT: .env is gitignored — never commit real credentials.
# All services read from this file at startup via env_file in
# docker-compose.yml (Section 9.1 — Environment Parity).
# ==========================================================


# ==========================================================
# INFRASTRUCTURE — PostgreSQL (Section 5)
# ==========================================================
# Main application database (anizai-postgres container).
# POSTGRES_PASSWORD is the only strictly required value —
# docker-compose.yml will refuse to start without it.

POSTGRES_USER=anizai
POSTGRES_PASSWORD=
POSTGRES_DB=anizai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


# ==========================================================
# INFRASTRUCTURE — Airflow (Section 6A)
# ==========================================================
# Airflow metadata database (airflow-postgres container).
# Separate from the application DB to prevent Airflow's
# alembic migrations from interfering with init.sql (Design Decision D1).

AIRFLOW_POSTGRES_PASSWORD=airflow_localdev

# Fernet key: used to encrypt Airflow connection passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Airflow admin UI login credentials (localhost:8090).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin_localdev


# ==========================================================
# INFRASTRUCTURE — Grafana (Section 7.2)
# ==========================================================
# Grafana admin login (localhost:3000).

GRAFANA_ADMIN_PASSWORD=admin_localdev


# ==========================================================
# INFRASTRUCTURE — Kafka (Section 3, 8.2)
# ==========================================================
# For local producers running on the host: localhost:9092
# For services inside Docker: kafka:29092
# docker-compose.yml overrides this to kafka:29092 for the
# Airflow scheduler container automatically.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# ==========================================================
# AI ENRICHMENT — OpenAI (Section 4.2)
# ==========================================================
# Used by Flink Gold Job for:
#   - Cognitive Metadata Extraction (impact_level, urgency_level, etc.)
#   - Temporal Consensus Bundling (Polymarket/HackerNews summaries)
#   - Real-time translation (Hebrew/Russian Telegram channels)
#
# Get your key at: https://platform.openai.com/api-keys
# Note: GPT-4o is the default model. GPT-3.5-turbo is used for
# translation only (cheaper, sufficient quality — Sprint 13).

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o


# ==========================================================
# SOURCE: NewsAPI (Section B.4)
# ==========================================================
# REST API — Massive.com Stocks Starter Plan.
# Required for newsapi_high_frequency DAG (every 20 min).
# Get key at: https://newsapi.org/ or https://massive.com/

NEWS_API_KEY=


# ==========================================================
# SOURCE: FRED — Federal Reserve Economic Data (Section B.3)
# ==========================================================
# Required for fred_daily DAG (06:00 UTC daily).
# Free key at: https://fred.stlouisfed.org/docs/api/api_key.html

FRED_API_KEY=


# ==========================================================
# SOURCE: OpenWeather (Section B.6)
# ==========================================================
# Required for openweather_high_frequency DAG (every 10 min).
# Free tier supports the polling frequency used here.
# Get key at: https://openweathermap.org/api

OPENWEATHER_API_KEY=


# ==========================================================
# SOURCE: OpenSky Network (Section B.7)
# ==========================================================
# OAuth2 client credentials (replaced Basic Auth in March 2026).
# Required for opensky_high_frequency DAG (every 3 min).
# Authenticated tier: 4,000 calls/day (anonymous: ~100/day).
# Register at: https://opensky-network.org/

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=


# ==========================================================
# SOURCE: Polymarket (Section B.8)
# ==========================================================
# WebSocket + REST — real-time market odds and discussions.
# Polymarket producer runs as a streaming process (not a DAG).
# API key is optional for public market data but required for
# private/authenticated endpoints.
# Get key at: https://polymarket.com/

POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=


# ==========================================================
# SOURCE: Telegram (Section A.1)
# ==========================================================
# MTProto streaming via Telethon — monitors 7 OSINT channels.
# Telegram producer runs as a streaming process (not a DAG).
#
# To get API credentials:
#   1. Go to https://my.telegram.org/
#   2. Log in with your Telegram account
#   3. Click "API development tools"
#   4. Create a new application — copy api_id and api_hash
#
# Note: First run creates a .session file (interactive phone auth).
# Subsequent runs use the session file without prompting.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# ==========================================================
# SOURCE: ArXiv (Section B.1)
# ==========================================================
# Public API — no key required. Max results per query (default 200).

ARXIV_MAX_RESULTS=200


# ==========================================================
# SOURCE: HackerNews (Section B.2)
# ==========================================================
# Algolia public API — no key required.
# Base URL shown for reference; changing it is not recommended.

HACKERNEWS_API_BASE_URL=https://hn.algolia.com/api/v1


# ==========================================================
# SOURCE: Google Trends (Section B.5)
# ==========================================================
# Pytrends — no API key required. Uses internal Google cookies.
# No variables needed.
# ==========================================================
